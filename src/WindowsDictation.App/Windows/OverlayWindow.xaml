<Window x:Class="WindowsDictation.App.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="42"
        Height="42"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <Storyboard x:Key="DotPulse">
            <DoubleAnimation Storyboard.TargetName="DotScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.9" To="1.12"
                             Duration="0:0:0.9"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="DotScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.9" To="1.12"
                             Duration="0:0:0.9"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="StateDot"
                             Storyboard.TargetProperty="Opacity"
                             From="0.72" To="1"
                             Duration="0:0:0.9"
                             AutoReverse="True"
                             RepeatBehavior="Forever" />
        </Storyboard>
    </Window.Resources>

    <Border x:Name="Shell" Background="#E9252528" BorderBrush="#45FFFFFF" BorderThickness="1" CornerRadius="24">
        <Grid>
        <Ellipse x:Name="StateDot"
                 Width="12"
                 Height="12"
                 Fill="#7DD3FC"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="DotScale" ScaleX="1" ScaleY="1" />
            </Ellipse.RenderTransform>
        </Ellipse>
            <TextBlock x:Name="StatusText" Margin="40,0,14,0" VerticalAlignment="Center" Foreground="White" FontFamily="Segoe UI" FontSize="12" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
        </Grid>
    </Border>
</Window>

<Window x:Class="WindowsDictation.App.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340"
        Height="56"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">
    <Border x:Name="Shell"
            CornerRadius="8"
            Background="#F2252528"
            BorderBrush="#3FFFFFFF"
            BorderThickness="1"
            Padding="14,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Ellipse x:Name="StateDot"
                     Width="12"
                     Height="12"
                     Fill="#7DD3FC"
                     VerticalAlignment="Center" />

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center">
                <TextBlock x:Name="StateText"
                           Text="Ready"
                           Foreground="#FFFFFFFF"
                           FontSize="14"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="MessageText"
                           Text="Ctrl+Space"
                           Foreground="#C8FFFFFF"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="WindowsDictation.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Dictation Settings"
        Width="440"
        Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Microphone" FontWeight="SemiBold" />
            <ComboBox x:Name="MicrophoneComboBox"
                      Margin="0,6,0,0"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      MinHeight="32" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Whisper model" FontWeight="SemiBold" />
            <ComboBox x:Name="ModelComboBox"
                      Margin="0,6,0,0"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      MinHeight="32" />
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="Insertion mode" FontWeight="SemiBold" />
            <ComboBox x:Name="InsertionModeComboBox"
                      Margin="0,6,0,0"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      MinHeight="32" />
        </StackPanel>

        <StackPanel Grid.Row="6">
            <TextBlock Text="Global hotkey" FontWeight="SemiBold" />
            <DockPanel Margin="0,6,0,0">
                <ComboBox x:Name="HotkeyKeyComboBox"
                          Width="112"
                          DockPanel.Dock="Right"
                          SelectedValuePath="Content"
                          MinHeight="32">
                    <ComboBoxItem Content="Space" />
                    <ComboBoxItem Content="F8" />
                    <ComboBoxItem Content="F9" />
                    <ComboBoxItem Content="F10" />
                    <ComboBoxItem Content="F12" />
                </ComboBox>
                <WrapPanel VerticalAlignment="Center">
                    <CheckBox x:Name="ControlCheckBox" Content="Ctrl" Margin="0,0,14,0" />
                    <CheckBox x:Name="AltCheckBox" Content="Alt" Margin="0,0,14,0" />
                    <CheckBox x:Name="ShiftCheckBox" Content="Shift" Margin="0,0,14,0" />
                    <CheckBox x:Name="WindowsCheckBox" Content="Win" />
                </WrapPanel>
            </DockPanel>
        </StackPanel>

        <StackPanel Grid.Row="8">
            <TextBlock Text="Indicator position" FontWeight="SemiBold" />
            <ComboBox x:Name="IndicatorPositionComboBox"
                      Margin="0,6,0,0"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      MinHeight="32" />
        </StackPanel>

        <CheckBox x:Name="LaunchOnStartupCheckBox"
                  Grid.Row="10"
                  Content="Launch on startup"
                  VerticalAlignment="Center" />

        <DockPanel Grid.Row="12" LastChildFill="False">
            <Button Content="Cancel"
                    Width="92"
                    MinHeight="32"
                    Margin="0,0,8,0"
                    DockPanel.Dock="Right"
                    Click="CancelClicked" />
            <Button Content="Save"
                    Width="92"
                    MinHeight="32"
                    DockPanel.Dock="Right"
                    IsDefault="True"
                    Click="SaveClicked" />
        </DockPanel>
    </Grid>
</Window>

<Window x:Class="WindowsDictation.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Dictation"
        Width="620" Height="720" MinWidth="560" MinHeight="580"
        Background="#FAFAFA" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="Foreground" Value="#242424" /></Style>
        <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="8,3" /></Style>
        <Style TargetType="Button"><Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="14,4" /><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#D8D8D8" /><Setter Property="Foreground" Value="#242424" /><Setter Property="Cursor" Value="Hand" /></Style>
    </Window.Resources>
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="Auto" />
            <RowDefinition Height="22" /><RowDefinition Height="*" /><RowDefinition Height="20" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Windows Dictation" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="Make dictation feel effortless." Margin="0,4,0,0" Foreground="#6C6C6C" />
        </StackPanel>
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="10" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><TextBlock Text="Microphone" FontWeight="SemiBold" /><ComboBox x:Name="MicrophoneComboBox" Margin="0,6,0,0" DisplayMemberPath="Name" SelectedValuePath="Id" /></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Whisper model" FontWeight="SemiBold" /><ComboBox x:Name="ModelComboBox" Margin="0,6,0,0" DisplayMemberPath="Label" SelectedValuePath="Value" /></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="0"><TextBlock Text="Insertion mode" FontWeight="SemiBold" /><ComboBox x:Name="InsertionModeComboBox" Margin="0,6,0,0" DisplayMemberPath="Label" SelectedValuePath="Value" /></StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Indicator position" FontWeight="SemiBold" /><ComboBox x:Name="IndicatorPositionComboBox" Margin="0,6,0,0" DisplayMemberPath="Label" SelectedValuePath="Value" /></StackPanel>
                <StackPanel Grid.Row="4" Grid.ColumnSpan="3">
                    <TextBlock Text="Global hotkey" FontWeight="SemiBold" />
                    <DockPanel Margin="0,6,0,0"><ComboBox x:Name="HotkeyKeyComboBox" Width="112" DockPanel.Dock="Right" SelectedValuePath="Content"><ComboBoxItem Content="Space" /><ComboBoxItem Content="F8" /><ComboBoxItem Content="F9" /><ComboBoxItem Content="F10" /><ComboBoxItem Content="F12" /></ComboBox><WrapPanel VerticalAlignment="Center"><CheckBox x:Name="ControlCheckBox" Content="Ctrl" Margin="0,0,16,0" /><CheckBox x:Name="AltCheckBox" Content="Alt" Margin="0,0,16,0" /><CheckBox x:Name="ShiftCheckBox" Content="Shift" Margin="0,0,16,0" /><CheckBox x:Name="WindowsCheckBox" Content="Win" /></WrapPanel></DockPanel>
                </StackPanel>
                <CheckBox x:Name="LaunchOnStartupCheckBox" Grid.Row="6" Grid.ColumnSpan="3" Content="Launch on startup" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Grid Grid.Row="4">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel><TextBlock Text="Recent transcriptions" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="Stored on this device" Margin="10,3,0,0" Foreground="#7A7A7A" /></DockPanel>
            <Border Grid.Row="2" Background="White" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="10">
                <Grid Margin="14">
                    <TextBlock x:Name="EmptyHistoryText" Text="Your completed dictations will appear here." Foreground="#777777" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="TranscriptionHistoryItems"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#ECECEC" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding CreatedAt, StringFormat={}{0:MMM d, yyyy - HH:mm}}" FontSize="11" Foreground="#787878" /><TextBlock Text="{Binding Text}" Margin="0,4,0,0" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="1" Tag="{Binding}" Content="Copy" VerticalAlignment="Top" Click="CopyTranscriptClicked" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <DockPanel Grid.Row="6" LastChildFill="False"><Button Content="Cancel" Margin="0,0,8,0" DockPanel.Dock="Right" Click="CancelClicked" /><Button Content="Save changes" Background="#202020" BorderBrush="#202020" Foreground="White" DockPanel.Dock="Right" IsDefault="True" Click="SaveClicked" /></DockPanel>
    </Grid>
</Window>
